  npcName: Noxu
  dialogueThread:
  - thread: Welcome to my temple.
    dialogueColour: {r: 0, g: 0, b: 0, a: 1}
    isBold: 0
  - thread: 'It appears you have come in peace, right?


      No?'
    dialogueColour: {r: 0, g: 0, b: 0, a: 1}
    isBold: 0
  - thread: 'Ah, yes. You aren''t like everyone else: you are here to achieve greater
      power!'
    dialogueColour: {r: 0, g: 0, b: 0, a: 1}
    isBold: 0
  - thread: 'That''s great, but in order for you to gain further power, you will
      come across obstacles you must face.


      Right now, I am going to be one
      of those obstacles for you.'
    dialogueColour: {r: 0, g: 0, b: 0, a: 1}
    isBold: 0
  - thread: '*Come now, show me who you truly are.'
    dialogueColour: {r: 0.30980393, g: 0.16078432, b: 0.09411765, a: 1}
    isBold: 1
