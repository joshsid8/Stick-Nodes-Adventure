/* ===== Sasquatch Inspector widget skin — LIGHT =====
   Light-skin values for every --sasq-* token consumed by SasquatchWidgets.uss. Designed against
   Unity's light editor chrome (window ≈ #C8C8C8): wells go near-white like Unity's own light
   fields, the text ladder inverts to near-black inks, ink washes flip from white-alpha to
   black-alpha, and the accent family darkens for contrast on light surfaces (text-grade blues
   ≥ 4.5:1). Token NAME SET must stay identical to SasquatchWidgetThemeDark.uss (verified by the
   token-parity test). Loaded by LayoutTreeBuilder next to the sasq-skin-light root class. */

.sasq-skin-light {
    /* Surfaces */
    --sasq-window-bg: #C8C8C8;
    --sasq-well-bg: #FAFAFA;
    --sasq-well-bg-soft: rgba(250, 250, 250, 0.9);
    --sasq-control-bg: #E9E9E9;
    --sasq-control-bg-hover: #DEDEDE;
    --sasq-group-content-bg: #D2D2D2;
    --sasq-pane-bg: #D9D9D9;
    --sasq-pane-header-bg: #BEBEBE;
    --sasq-header-bg: #B8B8B8;
    --sasq-header-bg-hover: #AFAFAF;
    --sasq-card-bg: #E1E1E1;
    --sasq-box-bg: #DCDCDC;
    --sasq-swatch-hover-bg: #F2F2F2;
    --sasq-list-row-bg: rgba(255, 255, 255, 0.45);

    /* Borders & lines */
    --sasq-border: #A3A3A3;
    --sasq-border-strong: #8A8A8A;
    --sasq-border-hover: #8F8F8F;
    --sasq-divider: #9A9A9A;
    /* Collection row separators — polarity flips to black ink, and the card tray goes lighter than the
       content background (matching how the light wells go near-white). */
    --sasq-row-divider: rgba(0, 0, 0, 0.14);
    --sasq-row-rail: rgba(0, 0, 0, 0.26);
    --sasq-row-card-bg: rgba(255, 255, 255, 0.7);
    --sasq-drop-slot-border: rgba(90, 90, 90, 0.5);
    --sasq-drop-slot-bg: rgba(0, 0, 0, 0.063);
    /* Palette swatch edges — dark & visible so each color reads distinctly on the light field
       (dark keeps its subtle white edge through the var() fallback). */
    --sasq-swatch-border: rgba(0, 0, 0, 0.45);
    --sasq-swatch-border-hover: rgba(0, 0, 0, 0.72);

    /* Toggle switch — saturated blue ON track with a darker outline; the OFF knob is a mid grey
       so it stays visible on the light track (the checked knob is literal white on blue). */
    --sasq-toggle-on: #3D7DD6;
    --sasq-toggle-on-hover: #4B89DD;
    --sasq-toggle-on-hover-border: #2A62AE;
    --sasq-toggle-on-border: #2D5F9E;
    --sasq-knob: #6E6E6E;
    --sasq-knob-hover: #575757;

    /* Slider knob — see the dark sheet for why this is its own token. Mid grey so it stays solid
       and visible against the light track; hover DARKENS (the light-skin convention) where dark
       lightens. Both skins paint at full alpha: the stock thumb's 50% is the see-through bug. */
    --sasq-slider-knob: #737373;
    --sasq-slider-knob-hover: #5f5f5f;

    /* Text ladder (darkest → lightest on light) */
    --sasq-text-strong: #090909;
    --sasq-text-preview: #141414;
    --sasq-text-title: #1A1A1A;
    /* Container-title ink — the USS twin of LayoutTreeBuilder.TitleInk (WidgetPalette.LabelBright), so a
       group-shell header matches the Card / Rows / Foldout titles beside it. */
    --sasq-text-node-title: #1A1A1A;
    --sasq-text-body: #1F1F1F;
    --sasq-text-help: #202020;
    --sasq-text-label: #242424;
    --sasq-text-caption-hover: #1A1A1A;
    --sasq-add-glyph: #3C3C3C;
    --sasq-empty-msg: #333333;
    --sasq-text-muted: #3F3F3F;
    --sasq-text-soft: #454545;
    --sasq-text-faint: #444444;
    --sasq-text-caption: #4B4B4B;
    --sasq-text-dim: #494949;
    --sasq-chevron: #4A4A4A;
    --sasq-text-hint: rgba(15, 15, 15, 0.5);
    --sasq-text-axis: rgba(15, 15, 15, 0.55);

    /* Accent family — darkened for light surfaces */
    --sasq-accent: #2265B8;
    /* The USS twin of WidgetPalette.AccentSoft (light): a touch stronger than the dark value, because a
       translucent blue over a LIGHT surface loses more of itself than over a dark one. */
    --sasq-accent-soft: rgba(41, 107, 199, 0.14);
    /* The pressed/hover step of the same wash — the soft accent button needs somewhere to GO on hover. */
    --sasq-accent-softer: rgba(41, 107, 199, 0.26);
    --sasq-progress-fill: #2E71C4;
    --sasq-accent-text: #1A5FB4;
    --sasq-richtext-on-bg: rgba(45, 100, 190, 0.30);
    --sasq-richtext-on-border: rgba(35, 85, 170, 0.75);
    --sasq-banner-fg: #1D3A5F;
    --sasq-banner-dismiss: #3E5570;

    /* Pager */
    --sasq-pager-active: #2465BD;
    --sasq-pager-dot: rgba(0, 0, 0, 0.35);
    --sasq-pager-dot-hover: rgba(0, 0, 0, 0.55);
    --sasq-pager-gap: rgba(0, 0, 0, 0.5);
    --sasq-pager-count: #3C3C3C;
    --sasq-colhead-hover: #090909;

    /* Ink washes (black-alpha on light — polarity flips) */
    --sasq-ink-015: rgba(0, 0, 0, 0.03);
    --sasq-ink-03: rgba(0, 0, 0, 0.04);
    --sasq-ink-04: rgba(0, 0, 0, 0.05);
    --sasq-ink-05: rgba(0, 0, 0, 0.06);
    --sasq-ink-08: rgba(0, 0, 0, 0.09);
    --sasq-ink-10: rgba(0, 0, 0, 0.11);
    --sasq-ink-12: rgba(0, 0, 0, 0.14);
    --sasq-ink-14: rgba(0, 0, 0, 0.16);
    --sasq-ink-28: rgba(0, 0, 0, 0.30);

    /* Popups / floating chrome — near-white glass */
    --sasq-popup-bg: rgba(250, 250, 251, 0.98);
    --sasq-popup-bg-heavy: rgba(255, 255, 255, 0.96);
    --sasq-popup-heavy-border: rgba(0, 0, 0, 0.25);
    --sasq-popup-border: rgba(70, 80, 95, 0.5);
    --sasq-popup-divider: rgba(70, 80, 95, 0.35);
    --sasq-popup-text: #1B2129;
    --sasq-popup-text-soft: rgba(45, 52, 64, 0.9);
    --sasq-popup-text-faint: rgba(60, 68, 80, 0.9);
    --sasq-popup-headline: rgba(30, 38, 48, 0.95);
    --sasq-toast-text: #175A28;
    --sasq-tip-text: #141414;

    /* Status — darkened for light backgrounds */
    --sasq-success-text: #1B6E2E;
    --sasq-missing-fg: #8E2F2F;
    --sasq-danger-fg: #C22A2A;
    --sasq-warn-fg: #8A5A00;
    --sasq-playhead: #B87800;

    /* Mixed (multi-object) state */
    --sasq-mixed-fg: #4F4F4F;
    --sasq-mixed-border: #8C8C8C;
}

/* Simulated inspector background: on light, the build root paints the light window color so the
   layout reads correctly on ANY host — the dark designer canvas, a dark-editor inspector with a
   light theme assigned, and (invisibly) Unity's own light inspector. Dark deliberately has no
   counterpart rule (pixel parity with the historical look). */
.sasq-build-root.sasq-skin-light {
    background-color: var(--sasq-window-bg);
}
